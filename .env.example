# ---------------------------------------------------------------------------
# Alfira Bot - Environment Configuration
# ---------------------------------------------------------------------------
# Copy this file to .env and fill in the required values:
#   cp .env.example .env
#
# Then start the stack:
#   docker compose up -d
#
# After first login, complete the setup wizard to configure your server.
# ---------------------------------------------------------------------------

# ===========================================
# DISCORD CONFIGURATION (Required)
# ===========================================

# Get these from https://discord.com/developers/applications
DISCORD_CLIENT_ID=your-client-id-here
DISCORD_CLIENT_SECRET=your-client-secret-here
DISCORD_BOT_TOKEN=your-bot-token-here

# OAuth2 callback URL (must match what you configured in Discord Developer Portal)
DISCORD_REDIRECT_URI=https://your-domain.com/auth/callback

# ===========================================
# SECURITY (Required)
# ===========================================

# JWT secret for signing authentication tokens
# Generate with: openssl rand -hex 32
JWT_SECRET=your-secure-random-string-here

# ===========================================
# DATABASE (Optional)
# ===========================================

# SQLite database path. Set automatically in Docker; only needed if running
# the server directly without docker-compose (e.g., bun run packages/server/src/index.ts).
# DATABASE_URL=/data/alfira.db

# ===========================================
# ADVANCED (Optional)
# ===========================================

# Pre-seed guild and admin settings (for existing deployments or automated setup).
# New installs can leave these empty and configure via the in-app setup wizard.
# GUILD_ID=your-guild-id-here
# ADMIN_ROLE_IDS=your-admin-role-id-here

# Minutes the bot waits before leaving a voice channel when idle.
# Can also be changed via the setup wizard / admin settings. Default: 5
# VOICE_IDLE_TIMEOUT_MINUTES=5

# JWT refresh token expiration (e.g., "30d", "7d", "24h"). Default: 30d
# JWT_EXPIRES_IN=30d

# Log level: debug, info, warn, error, fatal. Default: info
# LOG_LEVEL=info

# Set to "json" for machine-readable structured logging. Default: human-readable colored output
# LOG_FORMAT=json

# Set to any value to disable colored log output (enabled by default; auto-disabled in production)
# NO_COLOR=1

# Comma-separated list of enabled music sources. Defaults to youtube,soundcloud.
# Can be changed later via admin settings.
# ENABLED_SOURCES=youtube,soundcloud

# ===========================================
# MUSIC SOURCE CREDENTIALS (Optional)
# ===========================================

# These are only needed if you want to use sources that require authentication.
# Leave them empty to keep those sources disabled.

# Spotify requires both a client ID and client secret from https://developer.spotify.com/dashboard
# SPOTIFY_CLIENT_ID=your-spotify-client-id
# SPOTIFY_CLIENT_SECRET=your-spotify-client-secret

# Apple Music requires a media API token (set to "token_here" for auto-fetch, or provide a JWT)
# APPLE_MUSIC_MEDIA_API_TOKEN=token_here

# Tidal requires an auth token
# TIDAL_TOKEN=your-tidal-token

# Google Drive searches publicly shared files by default.
# To access private files, provide your Google Drive cookies header.
# GOOGLE_DRIVE_COOKIES=your-cookie-header
