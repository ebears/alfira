{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": [
    ".pi/**",
    "packages/server/dist/**",
    "packages/web/dist/**",
    "packages/web/public/**",
    ".nodelink/**",
    "nodelink-config/**",
    "scripts/**"
  ],
  "entry": [
