{
  "name": "alfira",
  "version": "0.1.1",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun run --filter @alfira/server build && docker compose -f docker-compose.dev.yml up --build",
    "web:build": "bun run --filter @alfira/web build",
    "discord:unregister-commands": "bun run packages/server/src/utils/unregisterCommands.ts",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "check": "oxlint . && oxfmt --check ."
  },
  "devDependencies": {
    "oxfmt": "^0.59.0",
    "oxlint": "^1.74.0"
  },
  "overrides": {
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "packageManager": "bun@1.3.14"
}
