{
  "name": "alfira-bot",
  "private": true,
  "packageManager": "bun@1.3.11",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter @alfira-bot/server build && docker compose up --build",
    "web:build": "bun run --filter @alfira-bot/web build",
    "db:migrate": "bun run --filter @alfira-bot/server db:migrate",
    "db:generate": "bun run --filter @alfira-bot/server db:generate",
    "db:studio": "bun run --filter @alfira-bot/server db:studio",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check --write ."
  },
  "overrides": {
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "serialize-javascript": "7.0.4",
    "undici": "6.24.0",
    "lodash": "4.17.23",
    "ws": "8.21.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.10",
    "@types/node": "25.6.0",
    "typescript": "6.0.2"
  }
}
