{
  "name": "@alfira-bot/server",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./shared": "./dist/shared/index.js",
    "./shared/*": "./dist/shared/*"
  },
  "scripts": {
    "dev": "bun run src/index.ts",
    "build": "tsc --skipLibCheck",
    "db:generate": "cd ../.. && drizzle-kit generate",
    "db:migrate": "cd ../.. && drizzle-kit migrate",
    "db:migrate:deploy": "cd ../.. && drizzle-kit migrate",
    "db:studio": "cd ../.. && drizzle-kit studio"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "jsonwebtoken": "9.0.3",
    "seyfert": "4.3.0",
    "ws": "8.21.0"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "9.0.10",
    "bun-types": "1.3.14",
    "@types/node": "25.5.2",
    "@types/ws": "8.18.1",
    "typescript": "7.0.2"
  }
}
